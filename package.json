{
	"name": "sharp-compress-cli",
	"version": "1.0.0",
	"private": true,
	"description": "input/ に置いた画像を sharp で圧縮して out/ に書き出す CLI",
	"license": "ISC",
	"type": "module",
	"scripts": {
		"prepare": "lefthook install",
		"typecheck": "tsc",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "node --test \"src/**/*.test.ts\""
	},
	"dependencies": {
		"sharp": "0.35.4"
	},
	"devDependencies": {
		"@types/node": "24.13.4",
		"lefthook": "2.1.12",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.4.2"
}
